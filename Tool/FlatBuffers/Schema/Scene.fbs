namespace scene;

struct vec2 {
    x:float;
    y:float;
}

struct vec3 {
    x:float;
    y:float;
    z:float;
}

struct vec4 {
    x:float;
    y:float;
    z:float;
    w:float;
}

table TransformComponentData {
    position:vec3;
    rotation:vec4;
    scale:vec3;
}

table RectTransformComponentData {
    anchor:vec2;
    position:vec2;
    size:vec2;
    pivot:vec2;
}

table CanvasComponentData {
    sort_order:int;
    receives_input:bool;
}

table CameraComponentData {
    fov:float;
    near_z:float;
    far_z:float;
    depth:int;
    render_path:int;
    render_pass_mask:uint;
}

table FreeCameraComponentData {
    yaw:float;
    pitch:float;
    move_speed:float;
    mouse_sensitivity:float;
}

table FbxRenderComponentData {
    model_path:string;
}

table RigidbodyComponentData {
    body_type:int;
    is_kinematic:bool;
    mass:float;
    linear_drag:float;
    angular_drag:float;
    use_gravity:bool;
    freeze_pos_x:bool;
    freeze_pos_y:bool;
    freeze_pos_z:bool;
    freeze_rot_x:bool;
    freeze_rot_y:bool;
    freeze_rot_z:bool;
}

table ColliderComponentData {
    shape_type:int;
    center:vec3;
    is_trigger:bool;
    debug_draw:bool;
    box_half_extents:vec3;
    sphere_radius:float;
    capsule_radius:float;
    capsule_half_height:float;
}

table PostEffectEntry {
    type_name:string;
    enabled:bool;
    priority:int;
}

table PostEffectComponentData {
    volume_priority:int;
    weight:float;
    blend_distance:float;
    is_global:bool;
    effects:[PostEffectEntry];
}

table SkyboxComponentData {
    cubemap_path:string;
    exposure:float;
    rotation_degrees:float;
    tint:vec3;
}

table GpuEffectComponentData {
    texture_path:string;
    max_particles:uint;
}

table CpuParticleComponentData {
    texture_path:string;
    max_particles:uint;
    emitter_type:uint;
    emit_rate:float;
    emit_radius:float;
    mesh_source_object_name:string;
    collision_mode:uint;
    subuv_rows:uint;
    subuv_cols:uint;
    subuv_fps:float;
}

table AnimationComponentData {
    state_machine_enabled:bool;
    speed:float;
    look_at_enabled:bool = false;
    look_at_target:vec3;
    look_at_weight:float = 1.0;
    look_at_follow_sharpness:float = 10.0;
    look_at_max_correction_degrees:float = 70.0;
    debug_mouse_look_at_enabled:bool = false;
    debug_mouse_look_at_distance:float = 6.0;
}

table NavAgentComponentData {
    navmesh_asset_path:string;
    move_speed:float;
    acceleration:float;
    stopping_distance:float;
    repath_interval:float;
}

table BehaviorTreeComponentData {
    asset_path:string;
    tree_enabled:bool;
    tick_interval:float;
}

table UITextComponentData {
    text:string;
    color:vec4;
    font_scale:float;
    alignment:int;
    graph_id:float;
    graph_metallic:float;
    graph_roughness:float;
    graph_ao:float;
    graph_blend:float;
}

table UIButtonComponentData {
    label:string;
    click_event_name:string;
    normal_color:vec4;
    hover_color:vec4;
    pressed_color:vec4;
    text_color:vec4;
    font_scale:float;
    corner_rounding:float;
    interactable:bool;
    block_mouse_input:bool;
    graph_id:float;
    graph_metallic:float;
    graph_roughness:float;
    graph_ao:float;
    graph_blend:float;
}

table UIImageComponentData {
    texture_path:string;
    tint_color:vec4;
    alpha:float;
    graph_id:float;
    graph_metallic:float;
    graph_roughness:float;
    graph_ao:float;
    graph_blend:float;
}

table UIPanelComponentData {
    background_color:vec4;
    border_color:vec4;
    border_width:float;
    alpha:float;
    graph_id:float;
    graph_metallic:float;
    graph_roughness:float;
    graph_ao:float;
    graph_blend:float;
}

table TimelineClipData {
    enabled:bool;
    animation_name:string;
    start_time:float;
    duration:float;
    clip_in_time:float;
    speed:float;
    loop:bool;
    track:int;
    weight:float;
    blend_in:float;
    blend_out:float;
    blend_in_curve:int;
    blend_out_curve:int;
}

table TimelineSignalData {
    enabled:bool;
    event_name:string;
    time:float;
}

table TimelineTrackData {
    name:string;
    binding_object_name:string;
    muted:bool;
    solo:bool;
    weight:float;
}

table TimelineComponentData {
    asset_path:string;
    duration:float;
    playback_speed:float;
    play_on_awake:bool;
    initial_time:float;
    update_method:int;
    wrap_mode:int;
    loop:bool;
    emit_signals:bool;
    tracks:[TimelineTrackData];
    clips:[TimelineClipData];
    signals:[TimelineSignalData];
}

union ComponentPayload {
    TransformComponentData,
    RectTransformComponentData,
    CanvasComponentData,
    CameraComponentData,
    FreeCameraComponentData,
    FbxRenderComponentData,
    RigidbodyComponentData,
    ColliderComponentData,
    PostEffectComponentData,
    SkyboxComponentData,
    GpuEffectComponentData,
    AnimationComponentData,
    NavAgentComponentData,
    BehaviorTreeComponentData,
    UITextComponentData,
    UIButtonComponentData,
    UIImageComponentData,
    CpuParticleComponentData,
    UIPanelComponentData,
    TimelineComponentData
}

table SerializedComponent {
    type_name:string;
    enabled:bool;
    payload:ComponentPayload;
}

table SerializedGameObject {
    name:string;
    enabled:bool;
    parent_index:int;
    tags:[int];
    components:[SerializedComponent];
    prefab_asset_path:string;
}

table SerializedScene {
    version:uint;
    scene_id:int;
    objects:[SerializedGameObject];
}

root_type SerializedScene;
file_identifier "SCN0";

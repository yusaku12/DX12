{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Debug x64",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				".\\DirectX12.sln",
				"/t:Build",
				"/p:Configuration=Debug",
				"/p:Platform=x64",
				"/p:UseMultiToolTask=true",
				"/p:EnforceProcessCountAcrossBuilds=true",
				"/nologo",
				"/m",
				"/v:minimal"
			],
			"group": "build"
		},
		{
			"label": "Build Release x64",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				".\\DirectX12.sln",
				"/t:Build",
				"/p:Configuration=Release",
				"/p:Platform=x64",
				"/p:UseMultiToolTask=true",
				"/p:EnforceProcessCountAcrossBuilds=true",
				"/nologo",
				"/m",
				"/v:minimal"
			],
			"group": "build"
		},
		{
			"label": "Build Release x64",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				".\\DirectX12.sln",
				"/t:Build",
				"/p:Configuration=Release",
				"/p:Platform=x64",
				"/p:UseMultiToolTask=true",
				"/p:EnforceProcessCountAcrossBuilds=true",
				"/nologo",
				"/m",
				"/v:minimal"
			],
			"group": "build"
		},
		{
			"label": "Clean Root Generated Artifacts",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-ChildItem -File -Filter '*.vcxproj.user' | Remove-Item -Force; Get-ChildItem -Directory -Filter 'DX12.*' | Remove-Item -Recurse -Force; if (Test-Path 'DirectX12') { Remove-Item 'DirectX12' -Recurse -Force }; if (Test-Path 'Intermediate') { Remove-Item 'Intermediate' -Recurse -Force }"
			],
			"group": "build"
		}
	]
}